# 1. Create the simulator object
set ns [new Simulator]

# Trace files (for analysis and for the NAM animation)
set tf [open out.tr w]
set nf [open out.nam w]
$ns trace-all $tf
$ns namtrace-all $nf

proc finish {} {
    global ns tf nf
    $ns flush-trace
    close $tf
    close $nf
    puts "Simulation finished. Trace written to out.tr"
    exit 0
}

# 2. Create nodes
set n0 [$ns node]   ;# TCP sender
set n1 [$ns node]   ;# UDP sender
set n2 [$ns node]   ;# router
set n3 [$ns node]   ;# receiver

# 3. Connect nodes with links (bandwidth, delay, queue type)
$ns duplex-link $n0 $n2 10Mb 10ms DropTail
$ns duplex-link $n1 $n2 10Mb 10ms DropTail
$ns duplex-link $n2 $n3 1Mb  20ms DropTail    ;# bottleneck
$ns queue-limit $n2 $n3 10

# 4. Create transport agents
set tcp  [new Agent/TCP/Reno]
set sink [new Agent/TCPSink]
set udp  [new Agent/UDP]
set null [new Agent/Null]

# 5. Attach agents to nodes and connect sender to receiver
$ns attach-agent $n0 $tcp
$ns attach-agent $n3 $sink
$ns connect $tcp $sink

$ns attach-agent $n1 $udp
$ns attach-agent $n3 $null
$ns connect $udp $null

# 6. Create traffic generators
set ftp [new Application/FTP]
$ftp attach-agent $tcp

set cbr [new Application/Traffic/CBR]
$cbr attach-agent $udp
$cbr set packetSize_ 500
$cbr set rate_ 0.5Mb

# 7. Schedule events
$ns at 0.5 "$ftp start"
$ns at 1.0 "$cbr start"
$ns at 4.0 "$cbr stop"
$ns at 4.5 "$ftp stop"
$ns at 5.0 "finish"

# 8. Run the simulation
$ns run
